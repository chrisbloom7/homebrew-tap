{
  "permissions": {
    "allow": [
      "Bash(brew style *)",
      "Bash(brew audit *)",
      "Bash(brew test *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/brew-style.sh"
          }
        ]
      }
    ]
  }
}
